rules_version = '2';

// El acceso server (checkout, webhook, panel admin) usa el Firebase Admin SDK con service
// account (ver src/lib/firebase/admin-app.ts), que BYPASSA estas reglas. Por eso estas reglas
// cierran de verdad el acceso del CLIENTE: solo se abre lo que el SDK cliente necesita leer en
// tiempo real (catálogo de productos y la orden de confirmación). Todo lo demás es deny.
//
// Las credenciales de MercadoPago se guardan encriptadas en `settings/mercadopago` (AES-GCM con
// MP_ENCRYPTION_KEY); aun con la colección cerrada, el cifrado es defensa en profundidad.

service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: lectura pública (catálogo), escritura solo desde el server.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Órdenes: el cliente de confirmación lee una orden puntual por id conocido
    // (external_reference, autoID no adivinable). No se permite listar.
    // La escritura es solo server-side.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;

      // Audit trail del webhook: solo server.
      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // Configuración (modo activo de MercadoPago, datos de transferencia): nunca desde el
    // cliente. Los datos de transferencia se sirven al comprador vía un route server público.
    match /settings/{docId} {
      allow read, write: if false;
    }

    // Colecciones internas: solo server.
    match /admin_invitations/{id} { allow read, write: if false; }
    match /counters/{id}          { allow read, write: if false; }

    // Default: denegar.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
